# 复制为 .env.local 后再填写。.env.local 已被 .gitignore 忽略，绝不能提交。
# 这些变量没有 VITE_ 前缀，只会被 vite.config.js 的开发服务器代理读取，不会打进前端代码。
# base_url、wire_api 和模型名可以从 Codex 的配置文件（~/.codex/config.toml）里抄。

# 不含末尾斜杠，例如 https://xxx/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# chat 走 POST {AI_BASE_URL}/chat/completions；responses 走 POST {AI_BASE_URL}/responses
AI_WIRE_API=chat

# 模型支持图片输入时才设为 true（照片导入功能）
AI_VISION=false
